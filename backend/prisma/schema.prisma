// Prisma schema for the H5P-style interactive learning app backend.
//
// Design notes:
// - Subject/Module ids reuse the human-readable slugs already used by the
//   frontend (e.g. "ipas", "bilangan-cacah-1000") so no remapping is needed.
// - Frame uses a composite key (moduleId, slug) instead of a single global id,
//   because frame ids (e.g. "bc1") are only unique *within* a module in the
//   existing content, not globally.
// - Frame-kind-specific fields (quiz questions, drag&drop items/zones, video
//   markers, pdf src, short-answer items, text body) are stored in the `data`
//   Json column rather than one column/table per kind. This keeps the schema
//   simple and lets new frame kinds be added without a migration.
// - Progress is tracked per anonymous `clientId` (a UUID the frontend
//   generates and stores in localStorage) when nobody is logged in. Once a
//   student logs in, the backend derives a canonical `clientId` of the form
//   "user:<userId>" instead of trusting whatever the client sends — this
//   keeps the ProgressRecord primary key shape unchanged while still letting
//   us join back to a real User via the denormalized `userId` column below
//   for report queries ("this student's scores across every module").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
  PARENT
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         Role
  grade        Int?             // school grade (1-6), only for STUDENT
  semester     Int?             // semester (1 or 2), only for STUDENT
  birthDate    DateTime?        // date of birth, only for STUDENT
  gender       String?          // 'Laki-laki' | 'Perempuan', only for STUDENT
  progress     ProgressRecord[]
  sessions     Session[]
  subscription Subscription?
  payments     Payment[]
  // Parent-Child relationships
  parentChildren  ParentChild[] @relation("Parent")
  childParents    ParentChild[] @relation("Child")
  readingProgress ReadingProgress[]
  assignmentsGiven ParentAssignment[] @relation("Parent")
  assignmentsReceived ParentAssignment[] @relation("Child")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("users")
}

// A logged-in session, one per successful login/register/refresh. The
// refresh token itself is never stored — only its SHA-256 hash — so a
// leaked database dump can't be used to impersonate anyone (same rationale
// as hashing passwords). Revoking a session (logout, or the user cabut-ing
// a device from their session list) sets `revokedAt`, which immediately
// invalidates that refresh token. The short-lived JWT access token it
// already issued keeps working until its own ~15 minute expiry — this
// is the standard, accepted trade-off of stateless access tokens.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
}

model Subject {
  id          String   @id
  name        String
  shortName   String
  description String
  icon        String
  accent      String
  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subjects")
}

model Module {
  id               String   @id
  subjectId        String
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  grade            Int
  semester         Int
  title            String
  subtitle         String
  summary          String
  estimatedMinutes String
  accent           String
  frames           Frame[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([grade, semester, subjectId])
  @@map("modules")
}

model Frame {
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug     String // original frame id within the module, e.g. "bc1"
  kind     String // 'text' | 'quiz' | 'dragdrop' | 'video' | 'pdf' | 'shortanswer'
  panel    String
  title    String
  note     String?
  order    Int // preserves display/sidebar sequence within the module
  data     Json // kind-specific payload, spread back onto the frame by the API

  @@id([moduleId, slug])
  @@index([moduleId, order])
  @@map("frames")
}

model ProgressRecord {
  clientId  String // "user:<userId>" once logged in, else the anonymous UUID
  moduleId  String
  frameSlug String
  userId    String? // set when clientId represents a logged-in user — enables report queries
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  correct   Int      @default(0)
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([clientId, moduleId, frameSlug])
  @@index([clientId, moduleId])
  @@index([userId])
  @@map("progress_records")
}

// ---------- Billing / Subscription (Xendit) ----------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

model Plan {
  id        String   @id // 'free_trial' | 'basic' | 'pro'
  name      String
  priceIdr  Int // 0 for the free trial
  interval  String // 'trial' | 'month'
  trialDays Int? // only set for the free trial plan
  features  Json // string[] of feature bullet points shown on the pricing page
  createdAt DateTime @default(now())

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

// One active subscription per user. A brand-new account is auto-enrolled in
// the free_trial plan at registration (see routes/auth.ts) so this always
// exists once someone has an account — there's no "no subscription" state.
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("subscriptions")
}

// One row per Xendit invoice created for a paid-plan checkout attempt.
// Starts PENDING; the Xendit webhook (routes/webhooks.ts) flips it to PAID
// or EXPIRED once the customer finishes (or abandons) the hosted checkout.
model Payment {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  amount           Int
  status           PaymentStatus @default(PENDING)
  xenditInvoiceId  String        @unique
  xenditInvoiceUrl String
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  @@index([userId])
  @@map("payments")
}

// ---------- Parent-Child System ----------

// Junction table linking parents to their children (students)
model ParentChild {
  id        String   @id @default(cuid())
  parentId  String
  parent    User     @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  childId   String
  child     User     @relation("Child", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("parent_children")
}

// Track reading progress for children
model ReadingProgress {
  id          String   @id @default(cuid())
  childId     String
  child       User     @relation(fields: [childId], references: [id], onDelete: Cascade)
  materialId  String   // references a module or external material
  materialType String  // 'module' | 'book' | 'article'
  title       String
  totalPages  Int      @default(0)
  currentPage Int      @default(0)
  status      String   @default("in_progress") // 'not_started' | 'in_progress' | 'completed'
  lastReadAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([childId, materialId])
  @@index([childId])
  @@map("reading_progress")
}

// Tasks/assignments created by parents for their children
model ParentAssignment {
  id            String   @id @default(cuid())
  parentId      String
  parent        User     @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  childId       String
  child         User     @relation("Child", fields: [childId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  materialId    String?  // optional link to a module
  selectedFrames Json?   // array of frame ids selected by parent, e.g. ["bc1", "bc3"]
  dueDate       DateTime?
  status        String   @default("pending") // 'pending' | 'in_progress' | 'completed' | 'overdue'
  notes         String?  // parent's notes or feedback
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([parentId])
  @@index([childId])
  @@map("parent_assignments")
}
