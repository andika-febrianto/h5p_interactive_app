# Copy this file to .env and adjust as needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/h5p_app?schema=public"
PORT=4000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:5173"
# Secret used to sign login tokens — set a long random value in production
# (e.g. `openssl rand -base64 48`). Never commit the real value.
JWT_SECRET="dev-only-insecure-secret-change-me"

# Xendit (payment gateway) — get these from your Xendit Dashboard.
# Use TEST mode keys while developing; switch to LIVE keys in production.
XENDIT_SECRET_KEY=""
# Set the same value in Xendit Dashboard > Settings > Webhooks > Verification Token.
XENDIT_CALLBACK_TOKEN=""
# Frontend origin, used to build Xendit's success/failure redirect URLs.
APP_URL="http://localhost:5173"
